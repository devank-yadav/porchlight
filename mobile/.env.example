# Copy to mobile/.env. Optional.
# Leave empty to use the laptop running `npx expo start` (phone must be on the same Wi-Fi).
# If campus Wi-Fi blocks that, run `ngrok http 3001` and paste the https URL here,
# or point it at a deployed server. Restart Expo after changing it.
EXPO_PUBLIC_API_URL=

# Lets the server send Peggy's phone notifications (her Uber button). In mobile/, run
# `npx eas-cli@latest init` once (it saves the id in app.json), or paste the project id here.
EXPO_PUBLIC_EAS_PROJECT_ID=
