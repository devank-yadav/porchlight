#!/bin/sh
# Team rule: no AI tool is listed as a co-author or contributor.
# Strips Claude co-author trailers, session links and "Generated with" lines from every commit message.
grep -v -i -E '^(Co-Authored-By:.*(claude|anthropic)|Claude-Session:|.*Generated with \[?Claude)' "$1" > "$1.tmp"
mv "$1.tmp" "$1"
