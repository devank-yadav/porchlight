# Copy to .env (repo root) and fill in. Never commit .env.
# Everything is optional: with nothing set, the server runs in development mode.

# --- AI model (any OpenAI-compatible endpoint: Luminal, OpenAI, Groq, ...) ---
# Check your provider's docs for the exact base URL and model name.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: a stronger model for the after-call summary and stories (not time-critical), e.g. claude-sonnet-5-5
LLM_ANALYSIS_MODEL=
# Newer Claude models think before answering; a caller is waiting, so this defaults to low ('' to omit)
LLM_REASONING_EFFORT=low
# Optional extra request headers as JSON (e.g. a workspace header for user-level keys)
LLM_HEADERS=

# --- MongoDB (Atlas free tier works). Empty = in-memory store. ---
MONGODB_URI=
MONGODB_DB=porchlight

# --- Twilio: sign-in codes by phone call, daily check-in calls, texts (optional) ---
# Without Twilio the server runs in development mode: sign-in codes are printed in this server's log
# and shown in the app (never with NODE_ENV=production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Caller ID for calls (a Twilio number, or a verified caller ID). Texts need a Twilio number.
TWILIO_FROM_NUMBER=
# Preferred for sign-in: a Twilio Verify service (Console > Verify > Services). Verify calls the
# number and reads the code itself. Without it, a Twilio call reads a code we make.
TWILIO_VERIFY_SERVICE_SID=
# Webhooks are checked against X-Twilio-Signature. Set to 1 only if a proxy rewrites the URL.
TWILIO_SKIP_SIGNATURE=0
# Public URL of the server for Twilio webhooks (e.g. an ngrok URL), no trailing slash
PUBLIC_URL=
# Voice for phone calls. Default: Google.en-US-Chirp3-HD-Aoede. Also Polly.<name> or ElevenLabs.<voiceId> (relay mode)
TWILIO_VOICE=
# Phone conversation mode:
#   gather = Twilio speech recognition (default; needs a paid Twilio account)
#   record = record her reply, transcribe locally with Whisper (works on Twilio trial; run server/stt/whisper_server.py)
#   relay  = Twilio ConversationRelay, streaming + interruptible (paid account + AI/ML addendum)
VOICE_MODE=gather

# --- Server ---
PORT=3001
# production: no development sign-in codes
NODE_ENV=
# Without MONGODB_URI, data is saved here (default server/data/porchlight.json). off = memory only.
PERSIST_FILE=
# Wait between escalation steps when help isn't confirmed (ms). Default 10 minutes.
ESCALATION_STEP_MS=
# Missed call: how many tries, and the wait between them (ms), before the family ladder starts
CALL_ATTEMPTS=2
CALL_RETRY_MS=120000
# Set to 1 to force quiet hours (texts for a missed check-in are held; help still goes out)
QUIET_HOURS_DEMO=0
# Tests and local demos only: 1 loads the fictional Hollis family (memory only, never saved)
SEED_DEMO=0

# Rides: Porchlight opens Uber with the trip filled in; the older adult confirms and pays there.
# Pickup is the home address added in the app. Optional Uber client id to tag the link:
UBER_CLIENT_ID=

# Live-call voice (ConversationRelay). Default: ElevenLabs "Rachel". Back to Google: Google.en-US-Chirp3-HD-Aoede
RELAY_VOICE=
