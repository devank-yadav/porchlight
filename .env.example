# Copy to .env (repo root) and fill in. Never commit .env.
# Everything is optional: with nothing set, the app runs in demo mode.

# --- AI model (any OpenAI-compatible endpoint: Luminal, OpenAI, Groq, ...) ---
# Check your provider's docs for the exact base URL and model name.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional extra request headers as JSON (e.g. a workspace header for user-level keys)
LLM_HEADERS=

# --- MongoDB (Atlas free tier works). Empty = in-memory store. ---
MONGODB_URI=
MONGODB_DB=porchlight

# --- Twilio: real SMS alerts + real phone check-ins (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL of the server for Twilio webhooks (e.g. an ngrok URL), no trailing slash
PUBLIC_URL=
# Voice for phone calls (any Twilio <Say> voice). Default: Google.en-US-Chirp3-HD-Aoede (natural)
TWILIO_VOICE=
# Phone conversation mode:
#   gather = Twilio speech recognition (default; needs a paid Twilio account)
#   record = record her reply, transcribe locally with Whisper (works on Twilio trial; run server/stt/whisper_server.py)
#   relay  = Twilio ConversationRelay, streaming + interruptible (paid account + AI/ML addendum)
VOICE_MODE=gather
# Real phone number to call as "Peggy" during the demo (E.164, e.g. +18145550123)
DEMO_SENIOR_PHONE=
# Real phone for the primary caregiver (Anne) so "put me through to Anne" can ring someone during the demo
DEMO_FAMILY_PHONE=

# --- Server ---
PORT=3001
# Escalation step delay in ms (demo speed; real life would be ~15 minutes)
ESCALATION_STEP_MS=5000
# Missed call: how many tries, and the wait between them (ms), before the family ladder starts
CALL_ATTEMPTS=2
CALL_RETRY_MS=120000
# Set to 1 to force quiet hours (texts for a missed check-in are held; help still goes out)
QUIET_HOURS_DEMO=0
# Simulated ride service: ms between APPROVED → REQUESTED → CONFIRMED (demo speed)
SANDBOX_STEP_MS=2000
# Set to 1 to reload demo data on every start
RESEED=0

# Rides: booked right away and the family gets a heads-up text (with an Uber link).
# RIDE_HOME_ADDRESS = real pickup address for the Uber link.
RIDE_HOME_ADDRESS=
UBER_CLIENT_ID=
