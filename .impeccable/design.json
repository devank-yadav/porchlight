    {
      "name": "Senior answer field",
      "kind": "input",
      "refersTo": "senior-input",
      "description": "Native 60pt minimum conversation field; browser typography is a fallback unless Atkinson is available. Browser illustration of native logical dimensions; focus outline is a browser preview affordance, not an established native focus treatment.",
      "html": "<input class=\"ds-senior-input\" aria-label=\"Your answer\" placeholder=\"Your answer\"/>",
      "css": ".ds-senior-input{min-height:60px;min-width:0;padding:0 18px;background:#FFFFFF;color:#252B2A;border:.5px solid #B7C0B9;border-radius:16px;font-family:\"Atkinson Hyperlegible\",sans-serif;font-size:22px}.ds-senior-input:hover{border-color:#B7C0B9}.ds-senior-input:focus-visible{outline:2px solid #252B2A;outline-offset:3px}.ds-senior-input:disabled{opacity:.45}"
    },
    {
      "name": "Task card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat white grouped surface with hairline border and 18pt padding.",
      "html": "<section class=\"ds-card\"><strong>Shared tasks</strong><p>Drop off soup Sunday</p></section>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:12px;padding:18px;background:#FFFFFF;color:#252B2A;border:.5px solid rgba(0,0,0,.08);border-radius:16px;font-family:system-ui,sans-serif;font-size:17px;line-height:24px}.ds-card strong{font-weight:600}.ds-card p{margin:0}"
    },
    {
      "name": "Neutral status badge",
      "kind": "chip",
      "refersTo": "badge-neutral",
      "description": "Family metadata; a written status in a soft neutral pill.",
      "html": "<span class=\"ds-badge\">Waiting for a check-in</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;align-self:flex-start;padding:4px 9px;background:#F0F0EE;color:#454D4A;border-radius:999px;font-family:system-ui,sans-serif;font-size:12px;font-weight:600;line-height:15px}"
    },
    {
      "name": "Family bottom tabs",
      "kind": "nav",
      "refersTo": "bottom-tabs",
      "description": "Base 76pt family tabs illustrated without device safe area. Native height also includes bottom inset and font-scale allowance; senior base is 104pt.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Family navigation\"><button class=\"ds-tab\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 10 12 3 21 10 M5 9v12h5v-7h4v7h5V9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Today</span></button><button class=\"ds-tab\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z M7 3v4 M17 3v4 M3 10h18 M7 14h2 M13 14h2 M7 18h2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Plans</span></button><button class=\"ds-tab\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M2 21v-2a6 6 0 0 1 12 0v2 M16 4a4 4 0 0 1 0 8 M17 15a5 5 0 0 1 5 5v1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Family</span></button><button class=\"ds-tab\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h6 M13 6h8 M9 3v6 M3 12h11 M18 12h3 M14 9v6 M3 18h4 M11 18h10 M7 15v6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Settings</span></button></nav>",
      "css": ".ds-tabs{display:flex;min-height:76px;padding-top:4px;padding-bottom:4px;background:#FFFFFF;border-top:.5px solid rgba(0,0,0,.08)}.ds-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;flex:1;min-height:44px;padding:0 8px;border:0;background:transparent;color:#626A67;font-family:system-ui,sans-serif;font-size:12px;line-height:16px;font-weight:600;cursor:pointer}.ds-tab[aria-current]{background:#F0F0EE;color:#252B2A}.ds-tab:hover{color:#252B2A}.ds-tab:focus-visible{outline:2px solid #252B2A;outline-offset:-3px}.ds-tab:active{opacity:.8}"
    },
    {
      "name": "People / Stories selector",
      "kind": "nav",
      "refersTo": "segmented",
      "description": "Nested family navigation with 44pt options and a white selected pill. Static browser states; native content switches have no slide.",
      "html": "<div class=\"ds-segmented\" role=\"tablist\" aria-label=\"Family details\"><button role=\"tab\" aria-selected=\"true\" class=\"ds-segment\">People</button><button role=\"tab\" aria-selected=\"false\" class=\"ds-segment\">Stories</button></div>",
      "css": ".ds-segmented{display:flex;padding:3px;background:#F0F0EE;border-radius:12px}.ds-segment{flex:1;min-height:44px;padding:0 12px;background:transparent;color:#626A67;border:0;border-radius:10px;font-family:system-ui,sans-serif;font-size:15px;font-weight:600;letter-spacing:-.2px;cursor:pointer}.ds-segment[aria-selected=true]{background:#FFFFFF;color:#252B2A;box-shadow:0 2px 8px rgba(0,0,0,.04)}.ds-segment:hover{color:#252B2A}.ds-segment:focus-visible{outline:2px solid #252B2A;outline-offset:-2px}.ds-segment:active{opacity:.8}"
    },
    {
      "name": "Shared appointment row",
      "kind": "custom",
      "refersTo": "plan-date",
      "description": "Family date block and written transport status; senior variant omits the date block and uses reading typography.",
      "html": "<article class=\"ds-plan\"><div class=\"ds-plan-date\" aria-hidden=\"true\"><span>Oct</span><strong>12</strong></div><div class=\"ds-plan-content\"><strong>Library visit</strong><span>Mon, Oct 12 · 10:00 AM</span><span>Sample library</span><span class=\"ds-plan-status\">Ride requested</span></div></article>",
      "css": ".ds-plan{display:flex;gap:16px;padding:20px 0;border-bottom:.5px solid rgba(0,0,0,.08);color:#252B2A;font-family:system-ui,sans-serif}.ds-plan-date{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:56px;height:66px;border-radius:12px;background:#F0F0EE;flex-shrink:0}.ds-plan-date span{font-size:13px;line-height:16px;color:#626A67;font-weight:600}.ds-plan-date strong{font-size:22px;line-height:28px}.ds-plan-content{display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;font-size:15px;line-height:21px}.ds-plan-content>strong{font-size:17px;line-height:22px;font-weight:600}.ds-plan-status{align-self:flex-start;padding:4px 9px;border-radius:999px;background:#F0F0EE;color:#454D4A;font-size:12px;font-weight:600;line-height:15px}"
    }
  ],
  "narrative": {
    "northStar": "The daily page",
    "overview": "Tella reads like a familiar daily agenda: a quiet paper ground, white task surfaces, charcoal text and clearly dated plans. The lamp gives status a recognizable visual presence. Plain words state the status and the next action.\n\nThe older person's experience makes reading and acting spacious; the family experience fits more coordination into compact rows. They share materials and appointments while retaining different type and control sizes. This document records the implemented consumer system; the retained dark palette and volunteer desk are outside this redesign.",
    "keyCharacteristics": [
      "Quiet paper grounds, white surfaces and hairline separation.",
      "Atkinson Hyperlegible for the older person; native system type for family.",
      "Persistent labeled bottom tabs and a shared dated appointment row.",
      "Large senior actions and compact family coordination.",
      "Written status, ownership and simulation labels."
    ],
    "rules": [
      {
        "name": "The Lamp Rule",
        "body": "The lamp is the signature accent. Pair its state with written status; color alone never carries the update.",
        "section": "colors"
      },
      {
        "name": "The Reading Floor Rule",
        "body": "Senior text is at least 20pt. Keep controls and text able to grow with the user's font scale.",
        "section": "typography"
      },
      {
        "name": "The Labeled Navigation Rule",
        "body": "Persistent tabs carry icons and visible words. Senior uses Today / My plans / Family; family uses Today / Plans / Family / Settings. Peer screen switches have no transition animation.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use the audience's palette and typography from the shared theme.",
      "**Do** keep senior text at least 20pt and senior action controls at least 104pt tall.",
      "**Do** keep family action controls at least 44pt tall.",
      "**Do** retain visible labels, written status and native safe-area allowances.",
      "**Do** reuse PlanRow for appointments and distinguish simulated transport in words.",
      "**Do** let facts, action groups and enlarged text wrap rather than truncate the next step.",
      "**Do** keep native device validation separate from browser preview evidence."
    ],
    "donts": [
      "**Don't** add a new accent or one-off button style outside the existing tokens and variants.",
      "**Don't** use red for ordinary pending or missed-check-in states.",
      "**Don't** animate peer tab switches.",
      "**Don't** treat a simulated booking or requested contact as confirmed real-world completion.",
      "**Don't** infer a house illustration style or creator attribution from inherited app assets."
    ]
  }
}
