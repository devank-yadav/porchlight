      "css": ".ds-senior-checkin{display:flex;align-items:center;justify-content:flex-start;gap:14px;min-height:104px;padding:20px;background:#252B2A;color:#FFFFFF;border:1px solid transparent;border-radius:16px;font-family:\"Atkinson Hyperlegible\",sans-serif;font-size:26px;font-weight:700;line-height:32px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-senior-checkin:hover{background:#252B2A}.ds-senior-checkin:focus-visible{outline:2px solid #252B2A;outline-offset:3px}.ds-senior-checkin:active{transform:scale(.97)}.ds-senior-checkin:disabled{opacity:.45;cursor:default}.ds-senior-checkin strong{display:block;font-weight:700}.ds-senior-checkin small{display:block;font-size:20px;line-height:27px;font-weight:400;margin-top:2px}@media(prefers-reduced-motion:reduce){.ds-senior-checkin{transition:none}.ds-senior-checkin:active{transform:none}}"
