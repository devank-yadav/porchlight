      "css": ".ds-senior-action{display:flex;align-items:center;justify-content:flex-start;gap:14px;min-height:104px;padding:20px;background:#FFFFFF;color:#252B2A;border:1px solid #DCE0DA;border-radius:16px;font-family:\"Atkinson Hyperlegible\",sans-serif;font-size:26px;font-weight:700;line-height:32px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-senior-action:hover{background:#FFFFFF}.ds-senior-action:focus-visible{outline:2px solid #252B2A;outline-offset:3px}.ds-senior-action:active{transform:scale(.97)}.ds-senior-action:disabled{opacity:.45;cursor:default}.ds-senior-action strong{display:block;font-weight:700}.ds-senior-action small{display:block;font-size:20px;line-height:27px;font-weight:400;margin-top:2px}@media(prefers-reduced-motion:reduce){.ds-senior-action{transition:none}.ds-senior-action:active{transform:none}}"
