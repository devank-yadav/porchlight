      "css": ".ds-button-lamp{display:flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 18px;background:#F5A524;color:#241500;border:0.5px solid transparent;border-radius:12px;font-family:system-ui,sans-serif;font-size:16px;font-weight:600;line-height:22px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-button-lamp:hover{background:#F5A524}.ds-button-lamp:focus-visible{outline:2px solid #252B2A;outline-offset:3px}.ds-button-lamp:active{transform:scale(.97)}.ds-button-lamp:disabled{opacity:.45;cursor:default}.ds-button-lamp strong{display:block;font-weight:700}.ds-button-lamp small{display:block;font-size:20px;line-height:27px;font-weight:400;margin-top:2px}@media(prefers-reduced-motion:reduce){.ds-button-lamp{transition:none}.ds-button-lamp:active{transform:none}}"
    },
    {
